{
  "name": "resulab",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:career": "node scripts/dev-career.mjs",
    "dev:upgrade": "node scripts/dev-upgrade.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:career:browser": "node scripts/test-career-workspace.mjs",
    "test:project:browser": "node scripts/test-project-workspace.mjs",
    "build:extension": "tsc -p extension/tsconfig.json && node scripts/build-jobs-extension.mjs",
    "test:jobs": "node --test tests/jobs*.test.cjs",
    "test:jobs:browser": "node scripts/test-jobs-browser.mjs",
    "test:jobs:input": "node scripts/test-jobs-input.mjs",
    "test:extension:browser": "node scripts/test-jobs-extension.mjs",
    "test:jobs:search": "node scripts/test-jobs-search.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "package:extension": "npm run build:extension && node scripts/package-jobs-extension.mjs",
    "prebuild": "npm run package:extension",
    "build:production": "node scripts/build-production.mjs",
    "build": "tsc -b && vite build",
    "build:tauri": "tsc -b && vite build --base=/",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.107.0",
    "@tauri-apps/api": "^2.11.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
