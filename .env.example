# Supabase 项目配置（可选：不配置则仅本地存储，云端功能不可用）
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 原有生成/润色服务，与新的 Agent 服务分开
VITE_AI_API_BASE=https://api.amorsum.top
# Agent 环境约定（待共享协议与服务接入）
VITE_AGENT_API_BASE=http://localhost:8788
# 仅开发模式显式开启；生产环境禁止模拟
VITE_AGENT_MOCK=false
