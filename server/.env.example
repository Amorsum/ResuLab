PORT=8788
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
MODEL_BASE_URL=https://provider.example/v1
MODEL_API_KEY=replace-on-server-only
MODEL_ID=actual-model-id
MODEL_TIMEOUT_MS=45000
MODEL_MAX_OUTPUT_TOKENS=8000
# Optional provider extension. Official DeepSeek defaults to disabled for this JSON workflow.
# MODEL_THINKING=disabled
MAX_CONCURRENT_RUNS=2
MAX_MODEL_CALLS_PER_RUN=6
MAX_MODEL_RETRIES=1
MAX_PENDING_RUNS_PER_USER=3
MAX_DAILY_RUNS_PER_USER=20
# Optional verified prices per 1,000,000 tokens; omit if unknown.
# MODEL_INPUT_PRICE_PER_MILLION=
# MODEL_OUTPUT_PRICE_PER_MILLION=
# Flat-rate estimates treat every input token as cache-miss; use peak rates for an
# upper estimate across time periods. Actual invoices may be lower (cache/off-peak).
MODEL_CURRENCY=CNY
# Optional local outbound proxy. Localhost bypasses it unless NO_PROXY is explicit.
# HTTPS_PROXY=http://127.0.0.1:your-proxy-port
# HTTP_PROXY=http://127.0.0.1:your-proxy-port
