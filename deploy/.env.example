# Local container verification: http://localhost:8080
SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443
ALLOWED_ORIGINS=http://localhost:8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
MODEL_BASE_URL=https://provider.example/v1
MODEL_API_KEY=replace-on-server-only
MODEL_ID=actual-model-id
MODEL_TIMEOUT_MS=45000
MAX_CONCURRENT_RUNS=2
MAX_MODEL_CALLS_PER_RUN=6
MAX_MODEL_RETRIES=1
MAX_PENDING_RUNS_PER_USER=3
MAX_DAILY_RUNS_PER_USER=20
MODEL_CURRENCY=CNY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_API_BASE=https://api.amorsum.top
# Empty means same-origin; A's useAgent must use this as the base URL.
VITE_AGENT_API_BASE=
